        # archi = self._grafo.edges(data=True)
        risultati = []

        for p in self._grafo.nodes:
            uscenti = self._grafo.out_edges(p, data=True)
            entranti = self._grafo.in_edges(p, data=True)
            numero = len(uscenti)
