    def getCamminoMassimo(self):
        punteggio_massimo = 0
        cammino_massimo = []
        for nodo in self._grafo.nodes:
            mesi = {nodo.datetime.month: 1}
            punteggio, cammino = self.ricorsione( nodo, [nodo], mesi, 100  )
            if punteggio > punteggio_massimo:
