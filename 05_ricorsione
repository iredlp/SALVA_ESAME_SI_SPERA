 def getGruppoProdotti(self, k, start_node, end_node):
        self._best_path = []
        self._best_score = float("-inf")

        # Il percorso parziale parte dal nodo selezionato
        parziale = [start_node]

        self._ricorsione(parziale, k, end_node, 0)

