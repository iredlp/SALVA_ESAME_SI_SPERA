    def _ricorsione(self, parziale, nodi, pos, tipo):
        # VALUTO LA SOLUZIONE PARZIALE
        if len(parziale) > 0:
            sottografo = self._grafo.subgraph(parziale)
            num_componenti = nx.number_connected_components(sottografo)

            # La soluzione è migliore se:
            # 1. ha più nodi
            # 2. a parità di nodi ha meno componenti
            if (len(parziale) > len(self._best_path) or
                    (len(parziale) == len(self._best_path) and
                     num_componenti < self._best_score)):
                self._best_path = list(parziale)
                self._best_score = num_componenti

        # CASO TERMINALE
        if pos == len(nodi):
            return
        # POTATURA
        if len(parziale) + (len(nodi) - pos) < len(self._best_path):
            return
        # CONSIDERO IL NODO CORRENTE
        candidato = nodi[pos]

        # Controllo che sia dello stesso tipo dei precedenti
        if tipo is None or candidato.Essenziale == tipo:
            parziale.append(candidato)

            # Chiamata ricorsiva: considero il nodo
            self._ricorsione(parziale, nodi, pos + 1,candidato.Essenziale)
            # BACKTRACKING
            parziale.pop()
        # Chiamata ricorsiva: NON considero il nodo
        self._ricorsione(parziale, nodi, pos + 1, tipo)
