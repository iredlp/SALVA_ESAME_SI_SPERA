 def getCamminoMigliore(self):
        migliore = []
        pesoMigliore = float("inf")

        for nodo in self._grafo.nodes:
            visitati = [nodo]
            cammino, peso = self.ricorsione( nodo, visitati, 0, -float("inf") )

            if len(cammino) > len(migliore):
                migliore = cammino
                pesoMigliore = peso

            elif len(cammino) == len(migliore):
                if peso < pesoMigliore:
                    migliore = cammino
                    pesoMigliore = peso
        return migliore, pesoMigliore

    def ricorsione(self, nodo, cammino, pesoTotale, pesoPrecedente):
        migliore = cammino[:]
        pesoMigliore = pesoTotale

        for vicino in self._grafo.successors(nodo):
            # Il nodo non deve essere già stato visitato
            if vicino in cammino:
                continue
            # Essential deve essere diverso dal nodo precedente
            if vicino.Essential == nodo.Essential:
                continue

            pesoArco = self._grafo[nodo][vicino]["weight"]
            # I pesi devono essere crescenti o uguali
            if pesoArco < pesoPrecedente:
                continue

            nuovoCammino = cammino + [vicino]
            nuovoPeso = pesoTotale + pesoArco

            camminoTrovato, pesoTrovato = self.ricorsione(  vicino, nuovoCammino, nuovoPeso,pesoArco  )

            if len(camminoTrovato) > len(migliore):
                migliore = camminoTrovato
                pesoMigliore = pesoTrovato

            elif len(camminoTrovato) == len(migliore):
                if pesoTrovato < pesoMigliore:
                    migliore = camminoTrovato
                    pesoMigliore = pesoTrovato

        return migliore, pesoMigliore

